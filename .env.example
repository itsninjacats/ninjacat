# Copy to .env and fill in. Used by compose.prod.yaml only — the development
# stack in compose.yaml carries its own throwaway values inline.

# Postgres: users, sessions, API keys.
POSTGRES_USER=ninjacat
POSTGRES_PASSWORD=
POSTGRES_DB=ninjacat

# ClickHouse: telemetry.
CLICKHOUSE_DB=ninjacat
CLICKHOUSE_USER=ninjacat
CLICKHOUSE_PASSWORD=

# The URL users actually reach the panel at. SvelteKit rejects form actions
# when this does not match the request, and better-auth uses it as base URL.
ORIGIN=https://ninjacat.example.com

# 32+ characters, high entropy: openssl rand -base64 32
BETTER_AUTH_SECRET=
