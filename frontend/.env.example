# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# The server's internal port (panel and query API). Server-side only; default shown.
# NINJACAT_INTERNAL_URL="http://localhost:8081"

# Self-observability: the panel sends its own RUM events and browser logs to this
# NinjaCat's intake. Off unless both are set. The token is an API key (create one
# for this purpose alone: it is visible to every visitor); the intake is the
# address browsers reach the server's :8080 under, on a host starting with
# "browser-intake.".
# PUBLIC_NINJACAT_RUM_CLIENT_TOKEN=""
# PUBLIC_NINJACAT_RUM_INTAKE="http://browser-intake.localhost:8080"
# PUBLIC_NINJACAT_ENV="dev"
