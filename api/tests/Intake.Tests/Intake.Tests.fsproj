    <Compile Include="MsgpackTests.fs" />
    <Compile Include="ProcessFrameTests.fs" />
    <Compile Include="TcpLogsTests.fs" />
    <Compile Include="IntakeCoreTests.fs" />
    <Compile Include="MigrationsTests.fs" />
    <Compile Include="CaptureTests.fs" />
    <Compile Include="ClickHouseRoundTripTests.fs" />
    <Compile Include="ApiTests.fs" />
    <Compile Include="AppTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="InstallTests.fs" />
    <Compile Include="ContainersTests.fs" />
    <Compile Include="KubeopsTests.fs" />
    <Compile Include="GoCompatTests.fs" />
    <Compile Include="DbmTests.fs" />
    <Compile Include="NdmTests.fs" />
    <Compile Include="MiscTests.fs" />
    <Compile Include="ProfilingTests.fs" />
    <Compile Include="SecurityTests.fs" />
