<Project Sdk="Microsoft.NET.Sdk">
  <!-- What every process of the server shares: settings, the ClickHouse and
       Postgres clients, the web host's defaults, self-monitoring. -->
  <PropertyGroup>
    <AssemblyName>NinjaCat.Api.Platform</AssemblyName>
    <RootNamespace>NinjaCat.Api.Platform</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="Hosting.fs" />
    <Compile Include="ClickHouse.fs" />
    <Compile Include="Postgres.fs" />
    <Compile Include="SelfMonitor.fs" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ClickHouse.Driver" />
    <PackageReference Include="Npgsql.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/Engine.fsproj" />
    <ProjectReference Include="../Storage/Storage.fsproj" />
  </ItemGroup>
</Project>
